<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/textDialogProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Название продукта"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black" />

    <TextView
        android:id="@+id/textDialogProductInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="100 ккал / 100г"
        android:textColor="#757575" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutGrams"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Количество грамм"
        app:suffixText="г"
        app:helperText="Введите вес порции">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editGrams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="100" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
